{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuthentication",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrRepositoryPush",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart",
        "ecr:BatchGetImage",
        "ecr:DescribeImages",
        "ecr:DescribeRepositories"
      ],
      "Resource": "arn:aws:ecr:AWS_REGION:AWS_ACCOUNT_ID:repository/ECR_REPOSITORY"
    },
    {
      "Sid": "EcsRegistrationAndRead",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:DescribeTaskDefinition",
        "ecs:DescribeClusters",
        "ecs:ListTasks",
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UpdateOnlyTargetService",
      "Effect": "Allow",
      "Action": ["ecs:CreateService", "ecs:UpdateService"],
      "Resource": "arn:aws:ecs:AWS_REGION:AWS_ACCOUNT_ID:service/ECS_CLUSTER/ECS_SERVICE"
    },
    {
      "Sid": "ReadApplicationLogGroup",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyEcsRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": ["TASK_EXECUTION_ROLE_ARN", "TASK_ROLE_ARN"],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PublishDeploymentMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "BDGET/DevOps"
        }
      }
    }
  ]
}
