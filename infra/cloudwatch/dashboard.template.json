{
  "start": "-PT6H",
  "periodOverride": "inherit",
  "widgets": [
    {
      "type": "metric",
      "x": 0, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "ECS service CPU and memory",
        "region": "AWS_REGION",
        "view": "timeSeries",
        "stat": "Average",
        "period": 300,
        "metrics": [
          ["AWS/ECS", "CPUUtilization", "ClusterName", "ECS_CLUSTER", "ServiceName", "ECS_SERVICE"],
          [".", "MemoryUtilization", ".", ".", ".", "."]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Application availability and logged errors",
        "region": "AWS_REGION",
        "view": "timeSeries",
        "period": 60,
        "metrics": [
          ["BDGET/DevOps", "Availability", "Application", "bdget", "Environment", "APP_ENVIRONMENT", "Service", "ECS_SERVICE", {"stat": "Minimum", "yAxis": "left"}],
          [".", "ApplicationErrorCount", ".", ".", ".", ".", ".", ".", {"stat": "Sum", "yAxis": "right"}],
          [".", "RunningTaskCount", ".", ".", ".", ".", ".", ".", {"stat": "Minimum", "yAxis": "left"}]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Deployment duration",
        "region": "AWS_REGION",
        "view": "timeSeries",
        "period": 300,
        "metrics": [
          ["BDGET/DevOps", "DeploymentDuration", "Application", "bdget", "Environment", "APP_ENVIRONMENT", "Service", "ECS_SERVICE", {"stat": "Average"}]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "CI quality: JaCoCo and mandatory validations",
        "region": "AWS_REGION",
        "view": "timeSeries",
        "period": 300,
        "metrics": [
          ["BDGET/DevOps", "JacocoLineCoverage", "Application", "bdget", "Environment", "APP_ENVIRONMENT", "Service", "ECS_SERVICE", {"stat": "Maximum", "yAxis": "left"}],
          [".", "CiValidationSuccess", ".", ".", ".", ".", ".", ".", {"stat": "Minimum", "yAxis": "right"}]
        ]
      }
    },
    {
      "type": "log",
      "x": 0, "y": 12, "width": 24, "height": 6,
      "properties": {
        "title": "Recent application errors",
        "region": "AWS_REGION",
        "view": "table",
        "query": "SOURCE 'LOG_GROUP_NAME' | fields @timestamp, @message, @logStream | filter @message like /level=(ERROR|WARN)/ | sort @timestamp desc | limit 50"
      }
    }
  ]
}
